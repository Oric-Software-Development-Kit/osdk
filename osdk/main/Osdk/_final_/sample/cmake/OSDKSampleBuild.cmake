function(run)
    execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${OSDK_ROOT}/lib" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "OSDK command failed (${result}): ${ARGV}")
    endif()
endfunction()

file(MAKE_DIRECTORY "${BUILD_DIR}" "${BUILD_DIR}/tmp" "${BUILD_DIR}/BUILD")
set(tmp "${BUILD_DIR}/tmp")
set(macro_file "${OSDK_ROOT}/macro/MACROS.H")
if(NOT EXISTS "${macro_file}")
    set(macro_file "${OSDK_ROOT}/macro/macros.h")
endif()

if(PICTURE)
    if(NOT PICTURE_MODE)
        set(PICTURE_MODE 2)
    endif()
    if(NOT PICTURE_OUTPUT)
        set(PICTURE_OUTPUT "${BUILD_DIR}/BUILD/picture.bin")
    endif()
    get_filename_component(picture_dir "${PICTURE_OUTPUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${picture_dir}")
    if(PICTURE_MODE STREQUAL "PACKED")
        set(picture_hir "${BUILD_DIR}/picture.hir")
        set(picture_pak "${BUILD_DIR}/picture.pak")
        run("${OSDK_ROOT}/bin/pictconv" -f1 -d0 -o2 "${SAMPLE_DIR}/${PICTURE}" "${picture_hir}")
        run("${OSDK_ROOT}/bin/filepack" -p "${picture_hir}" "${picture_pak}")
        run("${OSDK_ROOT}/bin/bin2txt" -s1 -f2 "${picture_pak}" "${PICTURE_OUTPUT}" _LabelPicture)
    else()
        run("${OSDK_ROOT}/bin/pictconv" -f1 -d0 "-o${PICTURE_MODE}" "${SAMPLE_DIR}/${PICTURE}" "${PICTURE_OUTPUT}")
    endif()
endif()

set(link_inputs)
set(basic_files)
foreach(source IN LISTS SOURCES)
    if(NOT EXISTS "${source}")
        get_filename_component(source_name "${source}" NAME)
        if(EXISTS "${BUILD_DIR}/${source_name}")
            set(source "${BUILD_DIR}/${source_name}")
        endif()
    endif()
    get_filename_component(ext "${source}" EXT)
    get_filename_component(base "${source}" NAME_WE)
    string(TOLOWER "${ext}" ext)
    if(ext STREQUAL ".c")
        run("${OSDK_CPP}" -E -P "-I${OSDK_ROOT}/include" -D__16BIT__ -D__NOFLOAT__ -DATMOS -o "${tmp}/${base}.c" "${source}")
        execute_process(
            COMMAND "${OSDK_ROOT}/bin/compiler" "-N${base}" ${COMPILER_FLAGS} "${tmp}/${base}.c"
            OUTPUT_FILE "${tmp}/${base}.c2"
            RESULT_VARIABLE result
        )
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "OSDK compiler failed (${result}) for ${source}")
        endif()
        run("${OSDK_ROOT}/bin/macrosplitter" "-M${macro_file}" "${tmp}/${base}.c2" "${tmp}/${base}")
        list(APPEND link_inputs "${tmp}/${base}")
    elseif(ext STREQUAL ".s" OR ext STREQUAL ".asm")
        list(APPEND link_inputs "${source}")
    elseif(ext STREQUAL ".bas")
        list(APPEND basic_files "${source}")
    else()
        message(FATAL_ERROR "Unsupported sample source: ${source}")
    endif()
endforeach()

if(link_inputs)
    run("${OSDK_ROOT}/bin/link65" ${LINK_FLAGS} -d ./ -i ./ -o "${tmp}/linked.s" -f -q ${link_inputs})
    run("${OSDK_ROOT}/bin/xa" "-I${OSDK_ROOT}/lib" "${tmp}/linked.s" -o "${BUILD_DIR}/final.out" -e "${BUILD_DIR}/xaerr.txt" -l "${BUILD_DIR}/symbols" "-bt${ADDRESS}" -DASSEMBLER=XA -W -C ${XA_FLAGS})
    run("${OSDK_ROOT}/bin/header" "-n${TAP_NAME}" "${BUILD_DIR}/final.out" "${BUILD_DIR}/${NAME}.tap" "${ADDRESS}")
endif()

if(basic_files)
    set(basic "${tmp}/${NAME}.bas")
    file(WRITE "${basic}" "")
    foreach(source IN LISTS basic_files)
        file(READ "${source}" contents)
        file(APPEND "${basic}" "#file ${source}\n${contents}\n")
    endforeach()
    if(link_inputs)
        set(basic_tap "${BUILD_DIR}/${NAME}.basic.tap")
        run("${OSDK_ROOT}/bin/bas2tap" -b2t1 -color1 "${basic}" "${basic_tap}")
        if(WIN32)
            execute_process(COMMAND cmd /c copy /b "${basic_tap}+${BUILD_DIR}/${NAME}.tap" "${BUILD_DIR}/${NAME}.combined.tap" RESULT_VARIABLE result)
        else()
            execute_process(COMMAND /bin/sh -c "cat \"${basic_tap}\" \"${BUILD_DIR}/${NAME}.tap\" > \"${BUILD_DIR}/${NAME}.combined.tap\"" RESULT_VARIABLE result)
        endif()
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Unable to append the binary payload to the BASIC TAP")
        endif()
        file(RENAME "${BUILD_DIR}/${NAME}.combined.tap" "${BUILD_DIR}/${NAME}.tap")
    else()
        run("${OSDK_ROOT}/bin/bas2tap" -b2t1 -color1 "${basic}" "${BUILD_DIR}/${NAME}.tap")
    endif()
endif()

if(DISK_NAME)
    run("${OSDK_ROOT}/bin/tap2dsk" "-n${NAME}" "${BUILD_DIR}/${NAME}.tap" "${BUILD_DIR}/${DISK_NAME}.dsk")
    run("${OSDK_ROOT}/bin/old2mfm" "${BUILD_DIR}/${DISK_NAME}.dsk")
endif()
