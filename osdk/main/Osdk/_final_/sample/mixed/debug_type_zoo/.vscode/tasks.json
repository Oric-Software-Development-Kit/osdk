{
    "version": "2.0.0",
    "tasks": [
        {
            // If this fails and the terminal seems to be using PowerShell, switch the
            // default terminal profile to Command Prompt (Settings ->
            // terminal.integrated.defaultProfile.windows -> Command Prompt).
            "label": "osdk_build",
            "type": "shell",
            "command": "osdk_build.bat",
            "options": { "cwd": "${workspaceFolder}" },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "osdk_build_and_run",
            "type": "shell",
            "command": "osdk_execute.bat",
            "options": { "cwd": "${workspaceFolder}" }
        }
    ]
}
