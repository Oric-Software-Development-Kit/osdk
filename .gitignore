*.obj
*.db
*.tlog
*.recipe
*.log
*.out
*.tap
*.wav
*.mp4
*.sna
*.txt
# The blanket *.txt above is aimed at build output, but the release tree ships a
# few genuine text files. They stay tracked once added, however a delete followed
# by a restore is silently dropped again, so name them explicitly.
!osdk/main/Osdk/_final_/Oricutron/LICENSE.txt
!osdk/main/Osdk/_final_/Oricutron/Links.txt
!osdk/main/Osdk/_final_/Oricutron/ChangeLog.txt
!osdk/main/Osdk/_final_/Oricutron/ReadMe.txt
*.swp
*.vsidx
*.suo
*.bmp
DUMP
symbols
osdk/main/.vs/
osdk/main/Build/
osdk/main/Osdk/_final_/Oricutron/*.gif
osdk/main/Osdk/_final_/Oricutron/*.avi
osdk/main/Osdk/_final_/Oricutron/*.dsk
osdk/main/Osdk/_final_/Oricutron/*.imd
osdk/main/Osdk/_final_/Oricutron/*.hfe
osdk/main/Osdk/_final_/Oricutron/*.zip
*copy.*
*- Copy*
osdk/main/Osdk/_final_/TMP/
osdk/main/Osdk/_final_/sample/**/build/

[Dd]ebug/
[Rr]elease/

osdk/main/Osdk/_final_/Oricutron/videos/
osdk/OldVersions/
osdk/main/Osdk/_final_/sample/assembly/known_issues/
osdk/main/osdk_issues.md

# Per-project editor / debugger state. The VS Code Oric extension drops these next
# to any project it debugs, including the shipped samples.
.vscode/
.oric-snapshots/

# Release / work-in-progress zips built next to the distribution folder. Scoped to
# this directory on purpose: the historical zips in osdk/OldVersions/ are tracked.
osdk/main/Osdk/*.zip

# Transient patches produced while reviewing (e.g. a PR fetched with .diff)
*.diff
*.patch

# Tool output regenerated by TestSuite/osdk_check.bat on every run.
osdk/main/TestSuite/output/
